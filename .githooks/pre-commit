#!/bin/sh
# Lightweight pre-commit checks. Uses Python's standard library only.
set -eu

python_cmd="python"
if ! command -v "$python_cmd" >/dev/null 2>&1; then
    python_cmd="python3"
fi

files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)
if [ -n "$files" ]; then
    echo "$files" | while IFS= read -r file; do
        [ -f "$file" ] || continue
        "$python_cmd" -m py_compile "$file" || {
            echo "Pre-commit failed: Python syntax error in $file"
            exit 1
        }
    done
fi

# Check staged text files for trailing whitespace.
staged=$(git diff --cached --name-only --diff-filter=ACM || true)
if [ -n "$staged" ]; then
    echo "$staged" | while IFS= read -r file; do
        [ -f "$file" ] || continue
        case "$file" in
            *.py|*.md|*.yml|*.yaml|*.txt|*.gitignore)
                if grep -n '[[:blank:]]$' "$file" >/dev/null 2>&1; then
                    echo "Pre-commit failed: trailing whitespace found in $file"
                    exit 1
                fi
                ;;
        esac
    done
fi

echo "Pre-commit checks passed."
